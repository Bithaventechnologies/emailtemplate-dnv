# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_platform?schema=public"

# ─── Redis / Queue ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-long-random-string"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# ─── Resend ─────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"
RESEND_FROM_NAME="Your Company"

# ─── Storage (local disk by default; S3-compatible shape) ──
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
STORAGE_PUBLIC_URL="http://localhost:4000/uploads"
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
API_CORS_ORIGIN="http://localhost:3000"

# ─── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Rate limiting ──────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=30

# ─── Queue sending limits (deliverability safety) ───────────
EMAIL_SEND_CONCURRENCY=5
EMAIL_SEND_RATE_PER_SECOND=10
